{
  "name": "new-app",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install && uv sync --all-packages",
    "dev": "pnpm --filter web dev",
    "dev:py": "uv run --package new-app-api fastapi dev python/api/src/new_app_api/main.py --port 8000",
    "dev:all": "vercel dev -L",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm lint:js && pnpm lint:py",
    "lint:js": "biome check .",
    "lint:py": "uv run ruff check . && uv run ruff format --check .",
    "format": "biome check --write . && uv run ruff check --fix . && uv run ruff format .",
    "typecheck": "pnpm -r --if-present typecheck && uv run mypy",
    "design:check": "impeccable detect apps/web/src",
    "design:sync": "python3 .claude/skills/design-system/scripts/design-tokens.py sync .",
    "design:tokens": "python3 .claude/skills/design-system/scripts/design-tokens.py check .",
    "copy:check": "python3 .claude/skills/direct-response-copywriting/scripts/voice-check.py check .",
    "test": "pnpm -r --if-present test && uv run pytest",
    "check": "pnpm lint && pnpm typecheck && pnpm design:tokens && pnpm copy:check && pnpm design:check && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "impeccable": "4.1.0"
  }
}
